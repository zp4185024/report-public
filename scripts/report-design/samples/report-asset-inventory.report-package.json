  "dataset": {
    "code": "report_asset_inventory",
    "name": "报表资产清单数据集",
    "queryText": "SELECT r.Code AS reportCode, r.Name AS reportName, r.SheetName AS sheetName, d.Code AS datasetCode, d.Name AS datasetName, CAST(r.IsEnabled AS int) AS isEnabled FROM dbo.RcReport r INNER JOIN dbo.RcDataset d ON d.Code = r.DatasetCode WHERE r.CreateTime >= @startDate OR @startDate IS NULL ORDER BY r.Code",
